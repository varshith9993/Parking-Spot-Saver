<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_surface">

    <!-- Full-bleed Native MapLibre Map -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fixed Center Pin Crosshair (Visible only during Manual Pin Selection) -->
    <ImageView
        android:id="@+id/ivCenterCrosshair"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:contentDescription="@string/choose_on_map"
        android:src="@drawable/ic_crosshair_pin"
        android:translationY="-20dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Map Unavailable Non-Blocking Fallback -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapFallback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ps_card_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/ps_card_stroke"
        app:strokeWidth="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/map_load_error"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/ps_text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Top Floating Overlays: Status Banner, Selection Coordinate Pill, Loading Bar -->
    <LinearLayout
        android:id="@+id/topOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ps_warning_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tvBannerMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/ps_warning_text"
                    tools:text="Location permission is needed." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBannerAction"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:text="@string/grant_permission"
                    android:textAllCaps="false"
                    android:textColor="@color/ps_warning_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPinCoordsPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ps_card_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/ps_card_stroke"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvTopSelectedCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/ps_text_primary"
                tools:text="12.97160, 77.59460" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ps_primary" />
    </LinearLayout>

    <!-- Right-Side Floating Map Controls (+ / - / My Location / Pin Drop) -->
    <LinearLayout
        android:id="@+id/mapControlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ps_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/ps_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/zoom_in"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add"
                    app:tint="@color/ps_text_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ps_card_stroke" />

                <ImageButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/zoom_out"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/ps_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/ps_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/ps_card_stroke"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btnMyLocation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/center_my_location"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_my_location"
                app:tint="@color/ps_accent_blue" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPinDropControl"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/ps_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/ps_card_stroke"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btnManualPinMode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/choose_on_map"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pin_drop"
                app:tint="@color/ps_primary" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Map Attribution Pill Anchored Above Bottom Sheet -->
    <TextView
        android:id="@+id/tvMapAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/ps_card_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="@string/map_attribution"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/ps_text_secondary"
        android:textSize="10sp"
        app:layout_anchor="@id/homeBottomSheet"
        app:layout_anchorGravity="top|start" />

    <!-- Google Maps-style Draggable Bottom Sheet -->
    <LinearLayout
        android:id="@+id/homeBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ps_card_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="216dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ps_card_stroke" />

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/ps_drag_handle" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingBottom="18dp">

                <!-- State 1: Manual Pin Selection Confirmation -->
                <LinearLayout
                    android:id="@+id/layoutPinSelectActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pin_select_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/ps_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/pin_select_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/ps_text_secondary" />

                    <TextView
                        android:id="@+id/tvPinSelectCoords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/ps_primary"
                        tools:text="12.97160, 77.59460" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelPinSelection"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/cancel"
                            android:textAllCaps="false"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmPinLocation"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.5"
                            android:text="@string/save_this_location"
                            android:textAllCaps="false"
                            android:textColor="@color/ps_on_primary"
                            app:backgroundTint="@color/ps_primary"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- State 2: Empty State -->
                <LinearLayout
                    android:id="@+id/layoutHomeEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_active_spot_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/ps_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/no_active_spot_subtitle"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/ps_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveGpsSpot"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/save_parking_location"
                        android:textAllCaps="false"
                        android:textColor="@color/ps_on_primary"
                        app:backgroundTint="@color/ps_primary"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChooseOnMapEmpty"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/choose_on_map"
                        android:textAllCaps="false"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- State 3: Active Parking Spot Details -->
                <LinearLayout
                    android:id="@+id/layoutHomeActiveSpot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Peek Header: Address + Distance Pill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHomeAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/ps_text_primary"
                                android:textStyle="bold"
                                tools:text="221B Baker Street, London" />

                            <TextView
                                android:id="@+id/tvHomeGpsStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="@color/ps_text_secondary"
                                tools:text="Live distance tracking" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHomeDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@color/ps_primary_container"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/ps_on_primary_container"
                            android:textStyle="bold"
                            tools:text="142 m" />
                    </LinearLayout>

                    <!-- Primary Peek Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeNavigate"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1.3"
                            android:text="@string/navigate"
                            android:textAllCaps="false"
                            android:textColor="@color/ps_on_primary"
                            app:backgroundTint="@color/ps_primary"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_directions"
                            app:iconTint="@color/ps_on_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeChangeLocation"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/change_location"
                            android:textAllCaps="false"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/ps_card_stroke" />

                    <!-- Date / Time / Elapsed Clean 3-Column Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_date"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/ps_text_secondary" />

                            <TextView
                                android:id="@+id/tvHomeDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="@color/ps_text_primary"
                                tools:text="Nov 18, 2026" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_time"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/ps_text_secondary" />

                            <TextView
                                android:id="@+id/tvHomeTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="@color/ps_text_primary"
                                tools:text="3:15 PM" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_elapsed"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/ps_text_secondary" />

                            <TextView
                                android:id="@+id/tvHomeElapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="@color/ps_primary"
                                android:textStyle="bold"
                                tools:text="12 min ago" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHomeCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/ps_text_secondary"
                        tools:text="12.97160, 77.59460" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ps_card_stroke" />

                    <!-- Note Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_note"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/ps_text_secondary" />

                            <TextView
                                android:id="@+id/tvHomeNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="@color/ps_text_primary"
                                tools:text="Level B2, Pillar 4" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeEditNote"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add_note"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ps_card_stroke" />

                    <!-- Photo Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/parking_photo_label"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/ps_text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeRemovePhoto"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remove_photo"
                            android:textAllCaps="false"
                            android:textColor="@color/ps_error"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeAddPhoto"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="@string/add_photo"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHomePhotoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ps_card_stroke"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="164dp">

                            <ImageView
                                android:id="@+id/ivHomePhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/photo_preview_title"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="#99000000"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="@string/tap_to_preview"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="#FFFFFF" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvHomePhotoMissing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/photo_missing_notice"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/ps_error"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutHomePhotoMetadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/ps_subtle_bg"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvHomePhotoTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/ps_text_primary" />

                        <TextView
                            android:id="@+id/tvHomePhotoGps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/ps_text_secondary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeRemoveSpot"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/remove_parking_spot"
                        android:textAllCaps="false"
                        android:textColor="@color/ps_error" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
